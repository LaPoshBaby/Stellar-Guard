{
  "name": "stellar-guard-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest"
  },
  "dependencies": {
    "next": "14.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@stellar/freighter-api": "1.7.1",
    "@stellar/stellar-sdk": "11.3.0",
    "axios": "1.7.2",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@types/node": "20.14.2",
    "@types/react": "18.3.3",
    "typescript": "5.4.5",
    "tailwindcss": "3.4.4",
    "postcss": "8.4.38",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.3",
    "@testing-library/react": "15.0.7",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/user-event": "14.5.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "ts-jest": "29.1.5",
    "@types/jest": "29.5.12"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(ts|tsx)$": ["ts-jest", {"tsconfig": {"jsx": "react-jsx"}}]
    },
    "moduleNameMapper": {
      "^@stellar/freighter-api$": "<rootDir>/src/__mocks__/freighter-api.ts"
    }
  }
